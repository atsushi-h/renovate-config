{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Expo / React Native: SDK 互換のため major は Dependency Dashboard 承認制にする",
  "extends": [
    "github>atsushi-h/renovate-config:react"
  ],
  "packageRules": [
    {
      "description": "Expo SDK / RN 系の minor・patch はまとめて 1 PR にする",
      "groupName": "expo sdk",
      "matchPackageNames": [
        "expo",
        "expo-*",
        "@expo/*",
        "react-native",
        "react-native-*"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "description": "Expo SDK / RN の major は expo install --fix で手動対応する",
      "matchPackageNames": [
        "expo",
        "expo-*",
        "@expo/*",
        "react-native"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    }
  ]
}
