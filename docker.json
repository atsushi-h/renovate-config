{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Docker: base image の major は目視レビューする（digest pin は default.json の docker:pinDigests が担当）",
  "packageRules": [
    {
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
