{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "React: 本体と型定義はバージョンを揃える必要があるため 1 PR にまとめる",
  "packageRules": [
    {
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "react"
    }
  ]
}
